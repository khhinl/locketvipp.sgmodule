[Header Rewrite]
^https?://://revenuecat.com(receipts$|subscribers/?(.*?)*$) header-del x-revenuecat-etag
^https?://://revenuecat.com(receipts$|subscribers/?(.*?)*$) header-del X-RevenueCat-ETag

[Script]
LocketGold = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://githubusercontent.com, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com
